# Compiled binaries
/tuck
/tuck.exe
/tuck-operator
/tuck-operator.exe
/tuckcsi
/tuckcsi.exe
*.exe

# Local dev data — NEVER commit secrets or root keys
*.db
tuck-dev-rootkey
tuck-rootkey.bin

# Test / local runtime artifacts
testdata/*
!testdata/minikube-root-token.example.txt
*.log

# IDE / agent local config
.claude/

# Web UI — built by `npm run build` in web/, not committed
web/node_modules/
web/.env
web/*.tsbuildinfo
internal/ui/assets/*
!internal/ui/assets/.gitkeep
